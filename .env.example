# Copy to .env and fill in. .env is gitignored; direnv loads it via .envrc.
#
# Setting OPENROUTER_API_KEY enables the OpenRouter backend automatically.
OPENROUTER_API_KEY=sk-or-...

# Repo-level scan settings — see README "Configuring a target repo".
# SENTRY_DSN=https://...               # DSN findings are reported to (or pass --dsn)
# INFERENCE_MODEL=haiku                # model tier: haiku | sonnet | opus
# SCAN_CONCURRENCY=4                   # parallel LLM batches
# REFACTOR_TASKS_SENTRY_CHUNK_SIZE=0   # findings per Sentry batch; 0 = all at once

# Optional inference overrides — see README "Inference backends".
# INFERENCE_PROVIDER=openrouter        # force a backend: openrouter | claude-cli
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL_HAIKU=anthropic/claude-3.5-haiku
# OPENROUTER_MODEL_SONNET=anthropic/claude-sonnet-4
# OPENROUTER_MODEL_OPUS=anthropic/claude-opus-4
